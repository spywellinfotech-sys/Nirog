<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ forces apps to draw edge to edge, which put the page under the status bar. Opt out so the system keeps the page below it. -->
    <style name="Theme.Nirog" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">@color/saffron</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
