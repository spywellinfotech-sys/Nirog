# Copy to .env for local builds. NEVER commit .env. Placeholder values only.
#
# Public client configuration (safe to ship inside the app; protected by Row Level Security):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Optional. Restrict this key to your Android package (com.nirog.app) and SHA-1 in Google Cloud.
GOOGLE_MAPS_API_KEY=
#
# Do NOT put the service_role key here or anywhere in this repository.
# It bypasses all security rules and must only ever live on a trusted server.
